// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  baseCurrency String   @default("EUR") @map("base_currency")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Exchange Rates ──────────────────────────────────────────────────────────

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(20, 8)
  date         DateTime @default(now())
  source       String   @default("api") // api | manual
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  LOAN_CONSUMER
  LOAN_AUTO
  MORTGAGE
  PERSONAL_DEBT
  PERSONAL_CREDIT
}

model Account {
  id              Int         @id @default(autoincrement())
  name            String
  type            AccountType
  currency        String      @default("EUR")
  institution     String?
  openingDate     DateTime?   @map("opening_date")
  isActive        Boolean     @default(true) @map("is_active")
  notes           String?
  currentBalance  Decimal     @default(0) @db.Decimal(20, 2) @map("current_balance")

  // Credit card fields
  creditLimit     Decimal?    @db.Decimal(20, 2) @map("credit_limit")
  currentDebt     Decimal?    @default(0) @db.Decimal(20, 2) @map("current_debt")

  // Loan / mortgage fields
  originalAmount  Decimal?    @db.Decimal(20, 2) @map("original_amount")
  remainingAmount Decimal?    @db.Decimal(20, 2) @map("remaining_amount")
  monthlyPayment  Decimal?    @db.Decimal(20, 2) @map("monthly_payment")
  interestRate    Decimal?    @db.Decimal(6, 4) @map("interest_rate")
  endDate         DateTime?   @map("end_date")
  startDate       DateTime?   @map("start_date")

  // Personal debt / credit fields
  counterpartyName String?    @map("counterparty_name")
  direction        String?    // owe | owed

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  transactions    Transaction[] @relation("AccountTransactions")
  transfersFrom   Transaction[] @relation("TransferFrom")
  transfersTo     Transaction[] @relation("TransferTo")

  @@map("accounts")
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  color        String     @default("#6366f1")
  icon         String     @default("📦")
  parentId     Int?       @map("parent_id")
  budgetGroup  String?    @map("budget_group")
  isActive     Boolean    @default(true) @map("is_active")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")

  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  transactions Transaction[]
  budgetPlans  BudgetPlan[]

  @@map("categories")
}

// ─── Budget Plans ────────────────────────────────────────────────────────────

model BudgetPlan {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  year       Int
  month      Int      // 1-12
  amount     Decimal  @db.Decimal(20, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, year, month])
  @@index([year, month])
  @@map("budget_plans")
}

// ─── Budget Rule Buckets ──────────────────────────────────────────────────────

model BudgetBucket {
  id            Int      @id @default(autoincrement())
  name          String
  targetPercent Decimal  @db.Decimal(5, 2) @map("target_percent")
  categories    String[] // array of category ids
  color         String   @default("#6366f1")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("budget_buckets")
}

// ─── Monthly Income Plan ──────────────────────────────────────────────────────

model MonthlyIncome {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(20, 2)
  currency  String   @default("EUR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("monthly_income")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  COMPENSATION
}

model Transaction {
  id                  Int             @id @default(autoincrement())
  type                TransactionType
  date                DateTime
  accountId           Int             @map("account_id")
  amount              Decimal         @db.Decimal(20, 2)
  currency            String
  amountEur           Decimal?        @db.Decimal(20, 2) @map("amount_eur")
  exchangeRate        Decimal?        @db.Decimal(20, 8) @map("exchange_rate")
  categoryId          Int?            @map("category_id")
  incomeSource        String?         @map("income_source")
  counterparty        String?
  note                String?
  source              String          @default("manual") // manual | csv_import
  linkedTransactionId Int?            @map("linked_transaction_id")
  compensationSource  String?         @map("compensation_source") // Tax | Energy | Cashback | Other

  // Transfer fields
  toAccountId         Int?            @map("to_account_id")
  toAmount            Decimal?        @db.Decimal(20, 2) @map("to_amount")
  toCurrency          String?         @map("to_currency")
  toExchangeRate      Decimal?        @db.Decimal(20, 8) @map("to_exchange_rate")

  importBatchId       Int?            @map("import_batch_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  account             Account         @relation("AccountTransactions", fields: [accountId], references: [id])
  toAccount           Account?        @relation("TransferTo", fields: [toAccountId], references: [id])
  fromAccount         Account?        @relation("TransferFrom", fields: [accountId], references: [id])
  category            Category?       @relation(fields: [categoryId], references: [id])
  linkedTransaction   Transaction?    @relation("LinkedTransactions", fields: [linkedTransactionId], references: [id])
  linkedBy            Transaction[]   @relation("LinkedTransactions")
  importBatch         ImportBatch?    @relation(fields: [importBatchId], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
  @@index([type])
  @@map("transactions")
}

// ─── CSV Import ───────────────────────────────────────────────────────────────

model ImportBatch {
  id           Int      @id @default(autoincrement())
  filename     String
  accountId    Int      @map("account_id")
  profileId    Int?     @map("profile_id")
  totalRows    Int      @map("total_rows")
  importedRows Int      @default(0) @map("imported_rows")
  skippedRows  Int      @default(0) @map("skipped_rows")
  status       String   @default("pending") // pending | done | failed
  createdAt    DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  profile      ImportProfile? @relation(fields: [profileId], references: [id])

  @@map("import_batches")
}

model ImportProfile {
  id          Int      @id @default(autoincrement())
  name        String
  bankName    String?  @map("bank_name")
  delimiter   String   @default(",")
  encoding    String   @default("UTF-8")
  columnMap   Json     @map("column_map") // { date, amount, description, currency, ... }
  dateFormat  String   @default("YYYY-MM-DD") @map("date_format")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches     ImportBatch[]

  @@map("import_profiles")
}

model KeywordRule {
  id         Int      @id @default(autoincrement())
  keyword    String
  categoryId Int      @map("category_id")
  isActive   Boolean  @default(true) @map("is_active")
  priority   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([keyword])
  @@map("keyword_rules")
}

// ─── Scheduled Payments ───────────────────────────────────────────────────────

model ScheduledPayment {
  id          Int      @id @default(autoincrement())
  name        String
  accountId   Int      @map("account_id")
  categoryId  Int?     @map("category_id")
  amount      Decimal  @db.Decimal(20, 2)
  currency    String   @default("EUR")
  dueDay      Int      @map("due_day") // day of month 1-31
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("scheduled_payments")
}
