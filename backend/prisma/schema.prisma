generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  baseCurrency String   @default("EUR") @map("base_currency")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(20, 8)
  date         DateTime @default(now())
  source       String   @default("api")
  createdAt    DateTime @default(now()) @map("created_at")
  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  LOAN_CONSUMER
  LOAN_AUTO
  MORTGAGE
  PERSONAL_DEBT
  PERSONAL_CREDIT
}

model Account {
  id              Int         @id @default(autoincrement())
  name            String
  type            AccountType
  currency        String      @default("EUR")
  institution     String?
  openingDate     DateTime?   @map("opening_date")
  isActive        Boolean     @default(true) @map("is_active")
  notes           String?
  currentBalance  Decimal     @default(0) @db.Decimal(20, 2) @map("current_balance")
  openingBalance  Decimal     @default(0) @db.Decimal(20, 2) @map("opening_balance")
  creditLimit     Decimal?    @db.Decimal(20, 2) @map("credit_limit")
  currentDebt     Decimal?    @default(0) @db.Decimal(20, 2) @map("current_debt")
  originalAmount  Decimal?    @db.Decimal(20, 2) @map("original_amount")
  remainingAmount Decimal?    @db.Decimal(20, 2) @map("remaining_amount")
  monthlyPayment  Decimal?    @db.Decimal(20, 2) @map("monthly_payment")
  interestRate    Decimal?    @db.Decimal(6, 4) @map("interest_rate")
  endDate         DateTime?   @map("end_date")
  startDate       DateTime?   @map("start_date")
  counterpartyName String?    @map("counterparty_name")
  direction        String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  transactions    Transaction[] @relation("AccountTransactions")
  transfersTo     Transaction[] @relation("TransferTo")
  @@map("accounts")
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  color        String     @default("#6366f1")
  icon         String     @default("📦")
  parentId     Int?       @map("parent_id")
  budgetGroup  String?    @map("budget_group")
  isActive     Boolean    @default(true) @map("is_active")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  transactions Transaction[]
  budgetPlans  BudgetPlan[]
  planItems    PlanItem[]
  @@map("categories")
}

model BudgetPlan {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(20, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  category   Category @relation(fields: [categoryId], references: [id])
  @@unique([categoryId, year, month])
  @@index([year, month])
  @@map("budget_plans")
}

model PlanItem {
  id           Int      @id @default(autoincrement())
  name         String
  groupName    String   @map("group_name")
  paymentType  String   @default("Monthly") @map("payment_type")
  categoryId   Int?     @map("category_id")
  keywordMatch String?  @map("keyword_match")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  category     Category? @relation(fields: [categoryId], references: [id])
  amounts      PlanAmount[]
  @@map("plan_items")
}

model PlanAmount {
  id          Int      @id @default(autoincrement())
  planItemId  Int      @map("plan_item_id")
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(20, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  planItem    PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  @@unique([planItemId, year, month])
  @@index([year, month])
  @@map("plan_amounts")
}

model BudgetBucket {
  id            Int      @id @default(autoincrement())
  name          String
  targetPercent Decimal  @db.Decimal(5, 2) @map("target_percent")
  categories    Int[]
  color         String   @default("#6366f1")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("budget_buckets")
}

model MonthlyIncome {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(20, 2)
  currency  String   @default("EUR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([year, month])
  @@map("monthly_income")
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  COMPENSATION
}

model Transaction {
  id                  Int             @id @default(autoincrement())
  type                TransactionType
  date                DateTime
  accountId           Int             @map("account_id")
  amount              Decimal         @db.Decimal(20, 2)
  currency            String
  amountEur           Decimal?        @db.Decimal(20, 2) @map("amount_eur")
  exchangeRate        Decimal?        @db.Decimal(20, 8) @map("exchange_rate")
  categoryId          Int?            @map("category_id")
  incomeSource        String?         @map("income_source")
  counterparty        String?
  note                String?
  source              String          @default("manual")
  linkedTransactionId Int?            @map("linked_transaction_id")
  compensationSource  String?         @map("compensation_source")
  toAccountId         Int?            @map("to_account_id")
  toAmount            Decimal?        @db.Decimal(20, 2) @map("to_amount")
  principalAmount     Decimal?        @db.Decimal(20, 2) @map("principal_amount")
  interestAmount      Decimal?        @db.Decimal(20, 2) @map("interest_amount")
  toCurrency          String?         @map("to_currency")
  toExchangeRate      Decimal?        @db.Decimal(20, 8) @map("to_exchange_rate")
  tags                String[]        @default([])
  importBatchId       Int?            @map("import_batch_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  account             Account         @relation("AccountTransactions", fields: [accountId], references: [id], map: "tx_account_fkey")
  toAccount           Account?        @relation("TransferTo", fields: [toAccountId], references: [id], map: "tx_to_account_fkey")
  category            Category?       @relation(fields: [categoryId], references: [id])
  linkedTransaction   Transaction?    @relation("LinkedTransactions", fields: [linkedTransactionId], references: [id])
  linkedBy            Transaction[]   @relation("LinkedTransactions")
  importBatch         ImportBatch?    @relation(fields: [importBatchId], references: [id])
  @@index([date])
  @@index([accountId])
  @@index([categoryId])
  @@index([type])
  @@map("transactions")
}

model ImportBatch {
  id           Int      @id @default(autoincrement())
  filename     String
  accountId    Int      @map("account_id")
  profileId    Int?     @map("profile_id")
  totalRows    Int      @map("total_rows")
  importedRows Int      @default(0) @map("imported_rows")
  skippedRows  Int      @default(0) @map("skipped_rows")
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  transactions Transaction[]
  profile      ImportProfile? @relation(fields: [profileId], references: [id])
  @@map("import_batches")
}

model ImportProfile {
  id          Int      @id @default(autoincrement())
  name        String
  bankName    String?  @map("bank_name")
  delimiter   String   @default(",")
  encoding    String   @default("UTF-8")
  columnMap   Json     @map("column_map")
  dateFormat  String   @default("YYYY-MM-DD") @map("date_format")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  batches     ImportBatch[]
  @@map("import_profiles")
}

model KeywordRule {
  id         Int      @id @default(autoincrement())
  keyword    String
  categoryId Int      @map("category_id")
  isActive   Boolean  @default(true) @map("is_active")
  priority   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([keyword])
  @@map("keyword_rules")
}

model ScheduledPayment {
  id          Int      @id @default(autoincrement())
  name        String
  accountId   Int      @map("account_id")
  categoryId  Int?     @map("category_id")
  amount      Decimal  @db.Decimal(20, 2)
  currency    String   @default("EUR")
  dueDay      Int      @map("due_day")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("scheduled_payments")
}
