# ──────────────────────────────────────────────
#  Personal Finance App — Environment Variables
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=financedb
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme_strong_password

# JWT Authentication
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# App defaults
BASE_CURRENCY=EUR
NODE_ENV=production

# Initial admin user (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Exchange rate API (free tier at https://www.exchangerate-api.com)
# Leave empty to use manual rates only
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_URL=https://v6.exchangerate-api.com/v6

# Frontend API URL (used at build time)
# In production, set to your server's URL
VITE_API_URL=http://localhost:4000
